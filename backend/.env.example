# ==============================================================================
# CampusVoice Backend Environment Configuration Template
# NOTE: DO NOT commit actual credentials or production secrets to version control.
# Copy this file to .env and replace placeholders with production values.
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=production

# Database Configuration (MongoDB Atlas or Self-Hosted)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://campus_prod_user:<PASSWORD>@cluster0.example.mongodb.net/campusvoice?retryWrites=true&w=majority

# JWT Authentication Secrets
# Generate a secure 256-bit key using: openssl rand -base64 48
JWT_SECRET=your_production_secure_jwt_secret_key_change_this_in_prod
JWT_EXPIRES_IN=7d

# CORS & Security Perimeters
# Comma-separated list of permitted origin URLs
ALLOWED_ORIGINS=https://campusvoice.example.com,https://campusvoice-admin.example.com

# Rate Limiting Parameters
LOGIN_RATE_LIMIT_MAX=5
API_RATE_LIMIT_MAX=100

# Media Upload & Cloudinary Storage (Optional for Cloud Hosting)
STORAGE_TYPE=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
