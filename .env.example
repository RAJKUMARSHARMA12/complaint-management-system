# CampusVoice Environment Configuration (Docker / Local Development)

# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (Docker MongoDB Container)
# Root Administrative Connection:
MONGO_URI=mongodb://admin:password123@localhost:27017/college_cms?authSource=admin
# Application User Connection:
MONGO_APP_URI=mongodb://college_user:college_password123@localhost:27017/college_cms

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_campusvoice_2026_dev
JWT_EXPIRES_IN=7d

# Media Storage Configuration (Docker Nginx Media Server / Local Storage)
STORAGE_TYPE=local
MEDIA_UPLOAD_DIR=./uploads
MEDIA_BASE_URL=http://localhost:8080/uploads
MEDIA_EMULATOR_BASE_URL=http://10.0.2.2:8080/uploads

# Web Management Portals
# Mongo Express Web UI: http://localhost:8081
# Media Server Health: http://localhost:8080/health
